# --- Backend (FastAPI) ---
# Where the backend listens. In docker-compose the frontend reaches it as http://backend:8000.
BACKEND_URL=http://localhost:8000

# Java execution: auto | docker | local | disabled
#   auto    -> docker if the CLI works, else local JDK, else disabled (study-only)
#   docker  -> require the sandbox container (falls back to disabled if unavailable)
#   local   -> run javac/java as an isolated subprocess (development machine)
#   disabled-> never execute; editor, hints and solutions still work
JAVA_EXECUTION_MODE=auto

# Image used when JAVA_EXECUTION_MODE=docker (build it with:
#   docker build -t sdet-gym-java:latest docker/java-executor )
JAVA_DOCKER_IMAGE=sdet-gym-java:latest

# Optional: OpenAI-compatible LLM for free-text evaluation.
# Leave empty to use the transparent rule-based rubric (always works offline).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Database: SQLite by default. For PostgreSQL use e.g.
#   DATABASE_URL=postgresql+psycopg2://gym:gym@postgres:5432/sdet_gym
# DATABASE_URL=

# Extra CORS origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deployment (see README "Deploying") ---
# Backend on Render  : blueprint from render.yaml (Docker + managed Postgres).
# UI on GitHub Pages : workflow .github/workflows/deploy-ui.yml (static export).
# The Pages UI reads the backend URL from the NEXT_PUBLIC_API_URL repo variable
# (Settings -> Secrets and variables -> Actions -> Variables), or you can paste
# the Render URL once in the dashboard's "Backend not reachable" box — it is
# stored per-browser in localStorage.
